<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app drives the terminal it joins sessions in, and quits itself to restart after an
	     upgrade, through Apple Events (osascript). Under the hardened runtime a release is signed
	     with, sending them needs this entitlement (docs/decisions.md D-040). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
